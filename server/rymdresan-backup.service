[Unit]
Description=Backup Rymdresan highscore database
After=rymdresan.service

[Service]
Type=oneshot
User=rymdresan
Group=rymdresan
WorkingDirectory=/opt/rymdresan-highscores
ExecStart=/usr/bin/python3 -m rymdresan.admin --config /etc/rymdresan/config.json backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rymdresan

