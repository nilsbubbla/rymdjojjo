{
  "allowed_game_versions": ["1.0.0", "1.1.0"],
  "allowed_platforms": ["web", "android"],
  "allowed_origins": [
    "http://www.fnirp.com",
    "http://fnirp.com",
    "https://www.fnirp.com",
    "https://fnirp.com",
    "https://localhost",
    "http://localhost",
    "capacitor://localhost",
    "http://127.0.0.1:5173",
    "http://localhost:5173",
    "http://192.168.50.107"
  ],
  "min_score": 0,
  "max_score": 250000,
  "min_duration_ms": 1000,
  "max_duration_ms": 1200000,
  "max_average_score_per_second": 5000,
  "run_ttl_ms": 1800000,
  "elapsed_tolerance_ms": 5000,
  "min_name_length": 1,
  "max_name_length": 15,
  "max_request_body_bytes": 4096,
  "leaderboard_size": 10,
  "runs_rate_limit": {"requests": 40, "window_seconds": 60},
  "scores_rate_limit": {"requests": 20, "window_seconds": 60},
  "database_path": "/var/lib/rymdresan/data/highscores.sqlite3",
  "json_path": "/var/lib/rymdresan/public/highscores.json",
  "backup_directory": "/var/lib/rymdresan/backups",
  "backup_keep": 30,
  "listen_host": "127.0.0.1",
  "listen_port": 8001
}
